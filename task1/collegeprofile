<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ABC College</title>
<style>
body{
    margin:0;
    font-family:Arial;
    background:#f4f7fb
}
header{
    background:#075985;
    color:white;
    text-align:center;
    padding:25px
}
nav{
    background:#082f49;
    padding:15px;
    text-align:center
}
nav a{
    color:white;
    text-decoration:none;
    margin:12px
}
main{
    padding:20px
}
h2{
    color:#075985
}
.cards{
    display:flex;
    flex-wrap:wrap;
    gap:15px
}
.card{
    background:white;
    padding:20px;
    flex:1 1 180px;
    border-radius:8px;
    box-shadow:0 2px 6px #ccc
}
button{background:#0284c7;color:white;padding:10px 18px;border:0;border-radius:5px}
</style>
</head>
<body>
<header>
<h1>Dr.RVR NRI UNIVERSITY</h1>
<p>Learn Today, Lead Tomorrow</p>
</header>
<nav>
<a href="#about">About</a><a href="#courses">Courses</a>
<a href="#facilities">Facilities</a><a href="#admission">Admissions</a>
</nav>
<main>
<section id="about">
<h2>About Our College</h2>
<p>ABC College provides quality education and practical learning opportunities.</p>
</section>
<section id="courses">
<h2>Our Courses</h2>
<div class="cards">
<div class="card"><h3>CSE</h3><p>Computer Science Engineering</p></div>
<div class="card"><h3>ECE</h3><p>Electronics and Communication</p></div>
<div class="card"><h3>EEE</h3><p>Electrical Engineering</p></div>
</div>
</section>
<section id="facilities">
<h2>Campus Facilities</h2>
<p>Library, computer labs, sports ground and hostel facilities.</p>
</section>
<section id="admission">
<h2>Admissions Open</h2>
<p>Apply now to begin your academic journey.</p>
<button onclick="document.getElementById('form').hidden=false">Apply Now</button>
<form id="form" hidden>
<p><input placeholder="Student Name" required></p>
<p><input type="email" placeholder="Email" required></p>
<button type="submit">Submit</button>
</form>
</section>
</main>
</body>
</html>

